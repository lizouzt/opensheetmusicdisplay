      <clef><sign>G</sign><line>2</line></clef>
      <measure-style><multiple-rest>2</multiple-rest></measure-style>
    </attributes>
    <note><rest/><duration>4</duration><type>whole</type></note></measure><measure number="2"><note><rest/><duration>4</duration><type>whole</type></note></measure><measure number="3"><note>
      <pitch><step>C</step><octave>4</octave></pitch>
      <duration>1</duration>
      
